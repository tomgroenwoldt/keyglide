RUST_LOG=tower_http=debug

SUPABASE_URL=http://127.0.0.1:54321
PUBLISHABLE_KEY=
SECRET_KEY=

# The `x` and `y` components of the project's ES256 JWT signing key. These are
# the public half of the key pair and are used only to verify access tokens, so
# they are not secret. Read them from the JWKS endpoint:
#   curl $SUPABASE_URL/auth/v1/.well-known/jwks.json
JWT_PUBLIC_KEY_X=
JWT_PUBLIC_KEY_Y=

EDITOR_SERVICE_ADDR=localhost:3001
